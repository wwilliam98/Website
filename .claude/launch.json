{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "portfolio",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["app.js"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "pathfinding-service",
      "runtimeExecutable": "pathfinding-service/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "pathfinding-service", "--port", "8000"],
      "port": 8000,
      "autoPort": false
    }
  ]
}
