# Caddy terminates HTTPS (gets and renews the Let's Encrypt certificate itself)
# and forwards to the Express container. HTTP is redirected to HTTPS automatically.
willwebx.com {
	reverse_proxy website:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-X-Powered-By
		-Server
	}
}

www.willwebx.com {
	redir https://willwebx.com{uri} permanent
}
