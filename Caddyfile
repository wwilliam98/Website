# Caddy terminates HTTPS (gets and renews the Let's Encrypt certificate itself)
# and forwards to the app containers. HTTP is redirected to HTTPS automatically.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options SAMEORIGIN
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-X-Powered-By
		-Server
	}
}

willwebx.com {
	encode zstd gzip
	reverse_proxy website:3000
	import security_headers
	# The React build's /static/ files have content hashes in their names, so
	# browsers can keep them for a year instead of re-checking on every visit.
	@hashed path /static/*
	header @hashed {
		# defer: replace Express's own "max-age=0" instead of adding a second header
		Cache-Control "public, max-age=31536000, immutable"
		defer
	}
}

www.willwebx.com {
	redir https://willwebx.com{uri} permanent
}

# Badminton app: a container from a separate compose project, reached over the
# shared "web" Docker network (see compose.yaml).
badminton.willwebx.com {
	encode zstd gzip
	reverse_proxy badminton-web:80
	import security_headers
}
