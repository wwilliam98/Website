<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="/images/pathFindingTargetIcon.jpeg" type="image/icon">
        <link rel="stylesheet" type="text/css" href="PathFinding.css"/>
        <title>Pathfinding Visualizer</title>
    </head>

    <body>
        <header class="pf-header">
            <a class="pf-brand" href="/">
                <img src="/images/pathFindingTargetIcon.svg" alt="" class="pf-brand-icon">
                Pathfinding Visualizer
            </a>
            <div class="pf-header-links">
                <a href="/" class="pf-link">Portfolio</a>
                <button id="helpButton" class="pf-icon-btn" type="button" aria-label="Show tutorial" title="Show tutorial">?</button>
            </div>
        </header>

        <div class="pf-toolbar" role="toolbar" aria-label="Visualizer controls">
            <div class="pf-toolbar-group">
                <label class="pf-field">
                    <span class="pf-field-label">Algorithm</span>
                    <select id="algorithmSelect" class="pf-select pf-control"></select>
                </label>
                <button id="VisualizeButton" class="pf-btn pf-btn-primary pf-control" type="button">Visualize</button>
            </div>

            <div class="pf-toolbar-group">
                <label class="pf-field">
                    <span class="pf-field-label">Speed</span>
                    <select id="speedSelect" class="pf-select">
                        <option value="40">Very slow</option>
                        <option value="30">Slow</option>
                        <option value="20">Normal</option>
                        <option value="10">Fast</option>
                        <option value="1" selected>Very fast</option>
                    </select>
                </label>
                <label class="pf-field">
                    <span class="pf-field-label">Maze</span>
                    <select id="mazeSelect" class="pf-select pf-control">
                        <option value="" selected>Generate...</option>
                        <option value="balanced">Recursive division</option>
                        <option value="horizontal">Horizontal skew</option>
                        <option value="vertical">Vertical skew</option>
                    </select>
                </label>
                <label class="pf-field">
                    <span class="pf-field-label">Board size <span id="boardSizeLabel"></span></span>
                    <input id="changeBoardSizeSlider" type="range" min="11" max="35" value="33" class="pf-slider pf-control">
                </label>
            </div>

            <div class="pf-toolbar-group pf-btn-row">
                <button id="startButtonClearPath" class="pf-btn pf-control" type="button">Clear path</button>
                <button id="startButtonClearWalls" class="pf-btn pf-control" type="button">Clear walls</button>
                <button id="startButtonClearWeights" class="pf-btn pf-control" type="button">Clear weights</button>
                <button id="startButtonClearBoard" class="pf-btn pf-control" type="button">Reset</button>
            </div>
        </div>

        <main class="pf-main">
            <section id="boardWrap" class="pf-board-wrap">
                <table id="board" aria-label="Pathfinding grid"></table>
            </section>

            <aside class="pf-panel">
                <section class="pf-card">
                    <h2 id="algoName" class="pf-card-title"></h2>
                    <div id="algoTags" class="pf-tags"></div>
                    <p id="algo_def" class="pf-card-text"></p>
                    <label id="greedControl" class="pf-field pf-greed" hidden>
                        <span class="pf-field-label">Greed <span id="greedValue">2×</span></span>
                        <input id="greedSlider" type="range" min="1" max="5" step="0.5" value="2" class="pf-slider pf-control">
                    </label>
                </section>

                <section class="pf-card">
                    <h2 class="pf-card-title">Draw</h2>
                    <div id="brushPicker" class="pf-brushes" role="radiogroup" aria-label="Brush">
                        <button type="button" class="pf-brush pf-brush-wide pf-control" data-tool="wall" role="radio"><span class="pf-swatch wall"></span>Wall <kbd>W</kbd></button>
                        <button type="button" class="pf-brush pf-brush-wide pf-control" data-tool="erase" role="radio"><span class="pf-swatch normal"></span>Erase <kbd>R</kbd></button>
                        <button type="button" class="pf-brush pf-control" data-tool="2" role="radio" title="Weight 2 (key 1)" aria-label="Weight 2"><span class="pf-swatch weight2"></span>2</button>
                        <button type="button" class="pf-brush pf-control" data-tool="4" role="radio" title="Weight 4 (key 2)" aria-label="Weight 4"><span class="pf-swatch weight4"></span>4</button>
                        <button type="button" class="pf-brush pf-control" data-tool="6" role="radio" title="Weight 6 (key 3)" aria-label="Weight 6"><span class="pf-swatch weight6"></span>6</button>
                        <button type="button" class="pf-brush pf-control" data-tool="8" role="radio" title="Weight 8 (key 4)" aria-label="Weight 8"><span class="pf-swatch weight8"></span>8</button>
                        <button type="button" class="pf-brush pf-control" data-tool="10" role="radio" title="Weight 10 (key 5)" aria-label="Weight 10"><span class="pf-swatch weight10"></span>10</button>
                    </div>
                    <p class="pf-hint">Click and drag on the grid to paint. Drag the start or target to move it. Weights are the cost of stepping onto a cell; keys 1 to 5 pick them too.</p>
                    <p id="show_display_status" class="pf-status" role="status" aria-live="polite">Ready</p>
                </section>

                <section id="resultsCard" class="pf-card" hidden>
                    <h2 class="pf-card-title">Last run <span id="resultsAlgo" class="pf-muted"></span></h2>
                    <p id="resultsOutcome" class="pf-outcome"></p>
                    <dl class="pf-stats">
                        <div><dt>Cells explored</dt><dd id="statVisited"></dd></div>
                        <div><dt>Path steps</dt><dd id="statSteps"></dd></div>
                        <div><dt>Path cost</dt><dd id="statCost"></dd></div>
                    </dl>
                </section>

                <section class="pf-card">
                    <h2 class="pf-card-title">Legend</h2>
                    <ul class="pf-legend">
                        <li><span class="pf-swatch start"></span>Start</li>
                        <li><span class="pf-swatch target"></span>Target</li>
                        <li><span class="pf-swatch wall"></span>Wall</li>
                        <li><span class="pf-swatch weight6"></span>Weight</li>
                        <li><span class="pf-swatch pf-swatch-visited"></span>Explored</li>
                        <li><span class="pf-swatch pf-swatch-path"></span>Path</li>
                    </ul>
                </section>
            </aside>
        </main>

        <div id="tutorial" class="pf-modal" hidden>
            <div class="pf-modal-card" role="dialog" aria-modal="true" aria-labelledby="tutorialTitle">
                <div class="pf-modal-top">
                    <span id="tutorialCounter" class="pf-muted"></span>
                    <button id="skipButton" class="pf-icon-btn pf-icon-btn-light" type="button" aria-label="Close tutorial">&times;</button>
                </div>
                <h2 id="tutorialTitle"></h2>
                <p id="tutorialBody"></p>
                <img id="mainTutorialImage" src="images/FinishFlag.gif" alt="">
                <div class="pf-modal-actions">
                    <button id="previousButton" class="pf-btn" type="button">Back</button>
                    <button id="nextButton" class="pf-btn pf-btn-primary" type="button">Next</button>
                </div>
            </div>
        </div>
    </body>
    <script type='module' src='./PathFindingVisualizer.js'></script>
</html>
